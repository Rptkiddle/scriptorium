  "/v1/files": {
   "post": {
    "description": "Donate a PDF (the request body, application/pdf). Replies at once;\nthe PDF is processed in the background (donation progress).",
    "operationId": "donate_v1_files_post",
    "parameters": [
     {
      "description": "The PDF's DOI or arXiv ID.",
      "in": "query",
      "name": "identifier",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "The PDF's DOI or arXiv ID.",
       "title": "Identifier"
      }
     },
     {
      "description": "Or the key of the item it is for.",
      "in": "query",
      "name": "item",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Or the key of the item it is for.",
       "title": "Item"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "title": "Response Donate V1 Files Post"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Donate"
   }
  },
  "/v1/files/held": {
   "get": {
    "description": "Every item with a held PDF (key, DOI, arXiv ID, MD5 of each PDF as\ndonated), for comparing locally before donating.",
    "operationId": "held_v1_files_held_get",
    "responses": {
