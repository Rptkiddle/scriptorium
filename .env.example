# Copy to .env (readable by you only: chmod 600 .env) and fill in.

# The database's password. Letters and digits only, since it is used inside
# an address; `openssl rand -hex 24` makes one.
POSTGRES_PASSWORD=

# Where everything that must outlive a container is kept on this machine.
SCRIPTORIUM_DATA=/srv/scriptorium

# The account that owns the files in SCRIPTORIUM_DATA/data and /settings
# (`id -u` and `id -g`).
SCRIPTORIUM_UID=1000
SCRIPTORIUM_GID=1000

# The time zone for times shown and for the weekly harvest's day and hour.
TZ=Europe/Amsterdam

# Memory PostgreSQL may use for its cache and for building indexes.
DB_SHARED_BUFFERS=2GB
DB_MAINTENANCE_WORK_MEM=1GB

# The commit the image is built from (`git rev-parse HEAD`), recorded in run folders.
GIT_COMMIT=
