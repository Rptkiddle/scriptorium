<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: app/build.sh installs it into ~/Library/LaunchAgents with __HOME__ filled in. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.rptkiddle.scriptorium</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Applications/Scriptorium.app/Contents/MacOS/Scriptorium</string>
        <string>daemon</string>
    </array>


    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/scriptorium/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/scriptorium/daemon.err.log</string>
</dict>
</plist>
